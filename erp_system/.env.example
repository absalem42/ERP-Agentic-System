# ERP System Environment Configuration
# Copy this file to .env and update with your actual values.

# Database configuration
DB_PATH=databases/erp_sample.db
ERP_SAMPLE_DB_PATH=databases/erp_sample.db

# Optional split-mode frontend configuration
# Set this only when Streamlit should call a separate FastAPI backend.
API_URL=http://localhost:8000

# Azure OpenAI configuration (primary hosted provider path)
AZURE_OPENAI_API_KEY=
# Optional full target URI form:
# AZURE_OPENAI_TARGET_URI=https://ai-la.cognitiveservices.azure.com/openai/deployments/gpt-4.1/chat/completions?api-version=2025-01-01-preview
AZURE_OPENAI_TARGET_URI=
AZURE_OPENAI_ENDPOINT=https://ai-la.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/erp.log
